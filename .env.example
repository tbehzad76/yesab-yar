# نام و URL سرویس‌ها
POSTGRES_USER=hesabyar
POSTGRES_PASSWORD=hesabyar
POSTGRES_DB=hesabyar
POSTGRES_HOST=db
POSTGRES_PORT=5432

# اتصال بک‌اند به دیتابیس (در صورت خالی بودن از اجزای بالا ساخته می‌شود)
DATABASE_URL=

# تنظیمات امنیتی
# دستور تولید کلید: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# CORS (آدرس‌های فرانت‌اند، جدا شده با کاما)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# تنظیمات عمومی
PROJECT_NAME=Hesabyar API
DEBUG=true
DEFAULT_CURRENCY=IRT
